    "@ant-design/icons": "^5.2.6",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "axios": "^1.6.2",
    "zustand": "^4.4.7",
    "dayjs": "^1.11.10",
    "classnames": "^2.3.2",
    "lodash": "^4.17.21",
    "query-string": "^8.1.0",
    "react-resizable": "^3.0.5",
    "react-grid-layout": "^1.4.4",
    "react-split-pane": "^0.1.92",
    "react-countup": "^6.5.0",
    "react-turnstile": "^1.1.3",
